// Template for PupaHost/Local.xcconfig — the git-ignored signing override.
//
//   cp PupaHost/Local.xcconfig.example PupaHost/Local.xcconfig
//
// Then replace the placeholder with your own Apple Developer team id (Xcode →
// Settings → Accounts, or developer.apple.com → Membership). This template is
// committed; Local.xcconfig is not. Never put a real team id in this file.
//
// Config.xcconfig pulls Local.xcconfig in with `#include?`, so a checkout
// without it still configures — signing then fails later, inside xcodebuild.
DEVELOPMENT_TEAM = YOURTEAMID

// Optional. The notarytool keychain profile the DMG channel signs with, created
// once with `xcrun notarytool store-credentials`. Not a secret — the credentials
// live in the keychain, this is only the name of them. Here so a release does
// not depend on remembering it.
// NOTARY_PROFILE = pupa-notary
