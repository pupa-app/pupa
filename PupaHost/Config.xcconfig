// Shared, committed build configuration.
//
// Signing identity is intentionally NOT stored in the Xcode project or in
// this file. Each developer provides their own Apple Developer team via a
// local, git-ignored override:
//
//   PupaHost/Local.xcconfig   ->   DEVELOPMENT_TEAM = YOURTEAMID
//
// The `#include?` below is optional: builds still succeed without the file
// (e.g. on CI), they just won't be code-signed for a specific team.
#include? "Local.xcconfig"

// iCloud Documents sync is enabled via the target's Signing & Capabilities
// (iCloud → CloudDocuments, container `iCloud.app.pupa.ios`), which sets
// CODE_SIGN_ENTITLEMENTS + PupaHost/PupaHost/PupaHost.entitlements in the
// project. The container id must stay in sync with `PupaStorage.containerID`.
// Each dev needs that container provisioned to their team (paid membership);
// without it, device/archive signing fails — simulator builds fall back to
// local storage and are unaffected.
