<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Only the keys Xcode can't synthesize from INFOPLIST_KEY_* build settings.
     GENERATE_INFOPLIST_FILE stays on; the generated keys merge over this file.
     Declares the .pupa file type so the share sheet carries a branded
     bundle and the OS opens received .pupa files in Pupa (tap-to-import),
     plus the App Store keys that have no INFOPLIST_KEY_ equivalent. -->
<plist version="1.0">
<dict>
	<!-- Exempt encryption only (TLS + Keychain) — skips the per-upload question. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Mac App Store category. -->
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<!-- Backends run on the user's own machine or LAN. Loopback is already ATS-exempt;
	     this covers http:// to a LAN address or *.local. Deliberately NOT
	     NSAllowsArbitraryLoads — public backends must be https. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.pupa-app.app-bundle</string>
			<key>UTTypeDescription</key>
			<string>Pupa app</string>
			<!-- Conform to public.data ONLY, not public.json: a json/text
			     conformance makes Files/QuickLook claim the file as previewable
			     text, so tapping shows the JSON instead of opening Pupa. As
			     opaque data, a tap routes to the owner app (tap-to-import). -->
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<!-- Extension only, no public.mime-type: chat apps (WhatsApp…)
			     resolve received files by MIME, and an application/json tag
			     maps to the system public.json (text) type, so the file
			     previews as raw JSON instead of offering "Open in Pupa".
			     Dropping the MIME forces extension-based routing. -->
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>pupa</string>
				</array>
			</dict>
		</dict>
	</array>
	<!-- Legacy alias: the type was `com.pupa.app-bundle` before the reverse-DNS
	     rename. Kept as an IMPORTED type (not exported — the new one is canonical)
	     so any file, share item, or cached OS binding still tagged with the old
	     UTI keeps routing to Pupa. Makes the rename fully non-breaking; safe to
	     drop once no old-tagged `.pupa` files remain in circulation. -->
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.pupa.app-bundle</string>
			<key>UTTypeDescription</key>
			<string>Pupa app</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>pupa</string>
				</array>
			</dict>
		</dict>
	</array>
	<!-- YES so Files.app routes a tap straight to Pupa: this key governs
	     in-place URL delivery vs an Inbox copy, NOT import semantics. Pupa
	     reads the original URL under startAccessingSecurityScopedResource()
	     and copies the bytes itself, so in-place delivery is exactly right.
	     A NO here makes Files treat Pupa as unable to open in place and fall
	     back to a generic QuickLook preview instead of opening the app.
	     Declaring the key (either value) silences App Store Connect's
	     "Missing Document Configuration" warning. -->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Pupa app</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.pupa-app.app-bundle</string>
				<string>com.pupa.app-bundle</string>
			</array>
		</dict>
	</array>
	<!-- Marketplace install links: `pupa-install://import?url=…&sha256=…`, tapped
	     from the marketplace page on iOS/iPadOS. Safari can't hand a website's
	     `.pupa` to Pupa directly (the file lands in Downloads and needs a manual
	     "Open in"), so the site sends a link instead and Pupa fetches the bytes
	     itself — see `stageRemoteImport` in AppView. One target builds both
	     platforms (SDKROOT = auto), so macOS registers the scheme too.
	     ONLY `pupa-install` is registered. The in-app `pupa` scheme (ChatLink)
	     and `pupa-pair` (QR pairing) are parsed in-process from trusted, locally
	     produced text; registering either would let any web page feed URLs into
	     navigation paths that were never written to distrust their input. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.pupa-app.pupa.install</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>pupa-install</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
