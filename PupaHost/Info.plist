<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Only the keys Xcode can't synthesize from INFOPLIST_KEY_* build settings.
     GENERATE_INFOPLIST_FILE stays on; the generated keys merge over this file.
     Declares the .pupaapp file type so the share sheet carries a branded
     bundle and the OS opens received .pupaapp files in Pupa (tap-to-import). -->
<plist version="1.0">
<dict>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.pupa.app-bundle</string>
			<key>UTTypeDescription</key>
			<string>Pupa app</string>
			<!-- Conform to public.data ONLY, not public.json: a json/text
			     conformance makes Files/QuickLook claim the file as previewable
			     text, so tapping shows the JSON instead of opening Pupa. As
			     opaque data, a tap routes to the owner app (tap-to-import). -->
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>pupaapp</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/json</string>
				</array>
			</dict>
		</dict>
	</array>
	<!-- Imports copy the bundle's content into the app; the original file is
	     never edited in place, so this is NO (silences App Store Connect's
	     "Missing Document Configuration" warning for document-type apps). -->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Pupa app</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.pupa.app-bundle</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
